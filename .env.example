# ---------------------------------------------------------------------------
# Ownly Club app configuration
#
# Copy this file to `.env` and fill in the real values. Everything prefixed
# with EXPO_PUBLIC_ is inlined into the JS bundle at build time, so it is
# readable by anyone who downloads the app. Only ever put PUBLIC credentials
# here. The Shopify *Storefront* API token is designed to be public; the
# Shopify *Admin* API token is NOT and must never appear in this file.
# ---------------------------------------------------------------------------

# Your myshopify domain (NOT the custom domain).
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=ownlyclub.myshopify.com

# Storefront API public access token.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> Create an app -> Configure Storefront API scopes
#   -> Install app -> copy the "Storefront API access token".
# Required scopes: unauthenticated_read_product_listings,
#   unauthenticated_read_product_inventory, unauthenticated_write_checkouts,
#   unauthenticated_read_checkouts, unauthenticated_write_customers,
#   unauthenticated_read_customers, unauthenticated_read_customer_tags,
#   unauthenticated_read_content
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version to target.
EXPO_PUBLIC_SHOPIFY_API_VERSION=2025-07

# Public storefront used for checkout hand-off, policy pages and share links.
EXPO_PUBLIC_STOREFRONT_URL=https://ownlyclub.in

# Optional: endpoint that stores Expo push tokens for broadcast campaigns.
# Leave blank to disable remote push registration (local notifications still work).
EXPO_PUBLIC_PUSH_REGISTRATION_URL=
