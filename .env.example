# ---------------------------------------------------------------------------
# Ownly Club app configuration
#
# Copy this file to `.env` and fill in the real values. Everything prefixed
# with EXPO_PUBLIC_ is inlined into the JS bundle at build time, so it is
# readable by anyone who downloads the app. Only ever put PUBLIC credentials
# here. The Shopify *Admin* API token is NOT public and must never appear.
# ---------------------------------------------------------------------------

# --- Catalogue, cart and checkout (Storefront API) -------------------------

# The myshopify domain, NOT the custom domain.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=qsm7xv-th.myshopify.com

# Storefront API public access token.
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> your app -> API credentials -> Storefront API access token.
# This token is designed to be public. Required scopes:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts
#   unauthenticated_read_checkouts
#   unauthenticated_write_customers
#   unauthenticated_read_customers
#   unauthenticated_read_content
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version. Shopify supports roughly the last four quarterly
# releases; a retired version is silently served by the oldest supported one.
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-07

# Public storefront, used for checkout hand-off, policy pages, share links and
# the Customer Account API discovery documents.
EXPO_PUBLIC_STOREFRONT_URL=https://ownlyclub.in

# --- Accounts, orders and addresses (Customer Account API) -----------------
#
# The store runs Shopify's NEW customer accounts, which are passwordless and
# OAuth-based. These need their own client, separate from the token above.
#
# Shopify admin -> Settings -> Customer accounts -> Customer Account API:
#   1. Enable the Customer Account API.
#   2. Under "Application setup", copy the Client ID below.
#   3. Add the redirect URI below to the allowed callback URIs.
#
# Leaving the client id blank is supported: the app hides sign-in, orders,
# addresses and profile rather than showing a button that cannot work.

EXPO_PUBLIC_CUSTOMER_ACCOUNT_CLIENT_ID=

# Must match a callback URI allow-listed in that same settings page, exactly.
# `ownly` is the app's URL scheme, declared in app.json.
EXPO_PUBLIC_CUSTOMER_ACCOUNT_REDIRECT_URI=ownly://auth/callback

# Customer Account API version.
EXPO_PUBLIC_CUSTOMER_API_VERSION=2026-07

# Numeric shop id. Only used to derive OAuth endpoints if the /.well-known
# discovery documents cannot be reached; discovery is preferred.
# Find it with: { shop { id } } on the Admin API.
EXPO_PUBLIC_SHOPIFY_SHOP_ID=94983258393

# --- Push notifications ----------------------------------------------------

# Endpoint that stores Expo push tokens. Blank disables remote registration.
EXPO_PUBLIC_PUSH_REGISTRATION_URL=
