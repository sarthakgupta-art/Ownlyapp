{
  "expo": {
    "name": "Ownly Club",
    "slug": "ownly-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": [
      "ownly",
      "shop.94983258393.ownly"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#111111",
    "backgroundColor": "#FBF9F6",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ownlyclub.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:ownlyclub.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Used only if you choose to upload a photo when contacting support.",
        "NSPhotoLibraryUsageDescription": "Used only if you choose to attach an image when contacting support."
      }
    },
    "android": {
      "package": "in.ownlyclub.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ownlyclub.in"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#111111",
          "imageWidth": 170,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9A7B4F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png"
  }
}
