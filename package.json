{
  "name": "ownly-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint . && tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run lint && npm test",
    "push:serve": "node server/push-server.mjs serve",
    "push:stats": "node server/push-server.mjs stats"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "^57.0.14",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.2"
  }
}
